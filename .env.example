# Скопируйте в .env или задайте в панели хостинга (Railway, VPS).
# Бот читает переменные через os.environ; при необходимости подключите python-dotenv локально.

# Обязательные
BOT_TOKEN=
AO3_USERNAME=
AO3_PASSWORD=

# Интервалы и файлы
CHECK_INTERVAL=180
REQUEST_DELAY=15
STATE_FILE=bot_state.json
# LOG_FILE=bot.log

# Глобальный админ: отчёты о VPS и команды /status, /topics только в ЛС с этим пользователем
# Username без @ (например druap_tg). Либо задайте числовой id вместо username:
ADMIN_TELEGRAM_USERNAME=druap_tg
# ADMIN_TELEGRAM_USER_ID=

# Периодическая отправка снимка VPS в ЛС админу (секунды). 0 — только по команде /status
ADMIN_STATUS_INTERVAL=3600
