# Файл `.env` в каталоге проекта (рядом с config.ini) подхватывается автоматически при старте.
# Приоритет: непустые переменные процесса → этот файл → config.ini.
# На Railway и т.п. задайте те же имена в панели переменных.

# Обязательные
BOT_TOKEN=
AO3_USERNAME=
AO3_PASSWORD=

# Необязательно: прокси только для Telegram Bot API (если с VPS до api.telegram.org нет TCP 443).
# Часто даёт подписка VPN в ЛК: SOCKS5 (предпочтительно socks5h:// для DNS через прокси) или HTTP.
# Пример: socks5h://user:pass@proxy.vendor.net:1080
# TELEGRAM_PROXY_URL=

# Интервалы и файлы
CHECK_INTERVAL=180
REQUEST_DELAY=15
STATE_FILE=bot_state.json
# LOG_FILE=bot.log

# Глобальный админ: отчёты о VPS и команды /status, /topics только в ЛС с этим пользователем
# Username без @ (например druap_tg). Либо задайте числовой id вместо username:
ADMIN_TELEGRAM_USERNAME=druap_tg
# ADMIN_TELEGRAM_USER_ID=

# Периодическая отправка снимка VPS в ЛС админу (секунды). 0 — только по команде /status
ADMIN_STATUS_INTERVAL=3600
