[TELEGRAM]
# Токен бота от @BotFather
BOT_TOKEN = YOUR_TELEGRAM_BOT_TOKEN
# Опционально: только запросы к api.telegram.org через прокси (SOCKS5: socks5h://user:pass@host:1080)
PROXY_URL =

[AO3]
# Имя пользователя AO3, за которым следить
USERNAME = YOUR_AO3_USERNAME
# Пароль нужен только для режима Inbox (если используется)
PASSWORD = YOUR_AO3_PASSWORD
# Задержка между запросами к AO3 (сек.)
REQUEST_DELAY = 15

[ADMIN]
# Глобальный админ: ЛС-отчёты VPS и команды /status, /topics (username без @)
TELEGRAM_USERNAME = 
# Числовой user id (надёжнее username); можно задать вместо TELEGRAM_USERNAME
TELEGRAM_USER_ID = 
# Интервал авто-отчёта VPS в ЛС (сек). 0 — только по /status
STATUS_INTERVAL = 3600

[APP]
# Интервал проверки (сек.)
CHECK_INTERVAL = 180
# Файл состояния
STATE_FILE = bot_state.json
# Файл логов (опционально)
LOG_FILE = bot.log

