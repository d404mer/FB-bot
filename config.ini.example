[TELEGRAM]
# Токен бота от @BotFather
BOT_TOKEN = YOUR_TELEGRAM_BOT_TOKEN
# Опционально: только запросы к api.telegram.org через прокси (локально: socks5://127.0.0.1:PORT)
# То же можно задать в .env как TELEGRAM_PROXY_URL (файл .env в этом же каталоге подхватывается автоматически).
PROXY_URL =

[AO3]
# Имя пользователя AO3, за которым следить
USERNAME = YOUR_AO3_USERNAME
# Пароль нужен только для режима Inbox (если используется)
PASSWORD = YOUR_AO3_PASSWORD
# Задержка между запросами к AO3 (сек.)
REQUEST_DELAY = 15

[ADMIN]
# Глобальный админ: ЛС-отчёты VPS и команды /status, /topics (username без @)
TELEGRAM_USERNAME = 
# Числовой user id (предпочтительно для таймерных отчётов, если Bot API не может resolve username)
TELEGRAM_USER_ID = 
# Интервал авто-отчёта VPS в ЛС (сек). 0 — только по /status
STATUS_INTERVAL = 3600

[APP]
# Интервал проверки (сек.)
CHECK_INTERVAL = 180
# Файл состояния
STATE_FILE = bot_state.json
# Файл логов (опционально)
LOG_FILE = bot.log

